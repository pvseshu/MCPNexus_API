# --- Django ---
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
JWT_SECRET=dev-jwt-secret-change-me
LOG_LEVEL=INFO
# Encrypts saved application credentials (defaults to DJANGO_SECRET_KEY if empty)
CREDENTIAL_ENCRYPTION_KEY=

# --- Postgres (host values; docker-compose overrides host/port for the web container) ---
POSTGRES_DB=mcpnexus
POSTGRES_USER=mcpnexus
POSTGRES_PASSWORD=mcpnexus
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_PROJECTS_COLLECTION=mcp_projects
QDRANT_TOOLS_COLLECTION=mcp_tools

# --- Embeddings (served locally via Ollama) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=bge-large
EMBEDDING_DIM=1024

# --- Azure OpenAI (GPT-5.2) ---
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-5.2

# --- MCP servers ---
# Spotify only: bearer token used by Run Test instead of the token API (leave empty to fetch one)
SPOTIFY_BEARER_TOKEN=
MCP_SERVER_BASE_URL=http://localhost:8000/mcp

# --- Orchestration tuning ---
PROJECT_MATCH_THRESHOLD=0.45
TOOL_MATCH_THRESHOLD=0.45
TOOL_CANDIDATE_COUNT=5
MAX_TOOL_CHAIN_STEPS=3
